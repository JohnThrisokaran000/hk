#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_control_flow_attributes : require
// Same contract as mm.comp (y[t][r] = dot(row r of W, x[t]) (+ bias[r]), same push constants) on cooperative
// matrices, with a 128 row x 128 token output tile per workgroup. Weights are decoded to f16 into shared memory,
// activations are rounded to f16, and products accumulate in f32 on 16 x 16 x 16 tiles. Eight subgroups of 32 lanes
// each own a 64 x 32 block of the tile (4 x 2 accumulators). The next K slice is fetched into registers while the
// current one is multiplied. Needs VK_KHR_cooperative_matrix and a subgroup size of 32; the engine only selects
// this kernel when the device reports both.

layout(local_size_x = 256) in;
layout(std430, binding = 0) restrict readonly buffer W { uint w32[]; };
// Only bindings 0 to 3 exist in the pipeline layout; the activations are read four floats at a time.
layout(std430, binding = 1) readonly buffer X { vec4 x4[]; };
layout(std430, binding = 2) buffer Y { float y[]; };
layout(std430, binding = 3) restrict readonly buffer B { float bias[]; };
layout(push_constant) uniform P {
    uint rows;
    uint cols;
    uint row_bytes;
    uint x_stride;
    uint y_stride;
    uint has_bias;
    uint x_off;
    uint y_off;
    uint n_tokens;
    uint mode;          // 0: y = result, 1: y += result
} p;

#include "common.glsl"

const uint BM = 128u;
const uint BN = 128u;
const uint BK = 32u;
// A row of the shared tiles is BK halves = 8 four-wide vectors, plus 2 vectors of padding so that consecutive rows
// start in different banks.
const uint LD4 = BK / 4u + 2u;
shared f16vec4 As[BM * LD4];
shared f16vec4 Bs[BN * LD4];
shared float Cs[8u * 256u];

f16vec4 ra[4];
f16vec4 rb[4];

// Reads the K slice starting at column k0 into registers: 1024 four-wide vectors per operand, 4 per lane.
void fetch(uint k0, uint r0, uint t0) {
    bool x_vec = ((p.x_off | p.x_stride) & 3u) == 0u;
    for (uint i = 0u; i < 4u; i++) {
        uint e = gl_LocalInvocationID.x + i * 256u;
        uint m = e >> 3;
        uint col = k0 + (e & 7u) * 4u;
        vec4 v = vec4(0.0);
        if (r0 + m < p.rows && col < p.cols) {
            uint o = (r0 + m) * p.row_bytes + (col / ELEMS) * BYTES;
            uint c = col % ELEMS;
            v = vec4(dq(o, c), dq(o, c + 1u), dq(o, c + 2u), dq(o, c + 3u));
        }
        ra[i] = f16vec4(v);
        vec4 a = vec4(0.0);
        if (t0 + m < p.n_tokens && col < p.cols) {
            uint xi = p.x_off + (t0 + m) * p.x_stride + col;
            a = x_vec ? x4[xi >> 2] : vec4(x4[xi >> 2][xi & 3u], x4[(xi + 1u) >> 2][(xi + 1u) & 3u],
                                           x4[(xi + 2u) >> 2][(xi + 2u) & 3u], x4[(xi + 3u) >> 2][(xi + 3u) & 3u]);
        }
        rb[i] = f16vec4(a);
    }
}

void stash() {
    for (uint i = 0u; i < 4u; i++) {
        uint e = gl_LocalInvocationID.x + i * 256u;
        uint at = (e >> 3) * LD4 + (e & 7u);
        As[at] = ra[i];
        Bs[at] = rb[i];
    }
}

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint sg = tid >> 5;
    uint lane = tid & 31u;
    uint r0 = gl_WorkGroupID.x * BM;
    uint t0 = gl_WorkGroupID.y * BN;
    uint sr = (sg & 1u) * 64u;
    uint st = (sg >> 1) * 32u;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[4][2];
    [[unroll]] for (uint i = 0u; i < 4u; i++) [[unroll]] for (uint j = 0u; j < 2u; j++) {
        acc[i][j] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    }

    fetch(0u, r0, t0);
    stash();
    barrier();
    for (uint k0 = 0u; k0 < p.cols; k0 += BK) {
        bool more = k0 + BK < p.cols;
        if (more) fetch(k0 + BK, r0, t0);
        [[unroll]] for (uint kk = 0u; kk < BK / 4u; kk += 4u) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b[2];
            [[unroll]] for (uint j = 0u; j < 2u; j++) {
                coopMatLoad(b[j], Bs, (st + j * 16u) * LD4 + kk, LD4, gl_CooperativeMatrixLayoutColumnMajor);
            }
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a;
                coopMatLoad(a, As, (sr + i * 16u) * LD4 + kk, LD4, gl_CooperativeMatrixLayoutRowMajor);
                [[unroll]] for (uint j = 0u; j < 2u; j++) acc[i][j] = coopMatMulAdd(a, b[j], acc[i][j]);
            }
        }
        barrier();
        if (more) stash();
        barrier();
    }

    // Each 16 x 16 accumulator goes through this subgroup's slice of shared memory so that bias, accumulation and the
    // row / token edges are handled per element. Stored column major: Cs[t * 16 + r].
    uint base = sg * 256u;
    [[unroll]] for (uint i = 0u; i < 4u; i++) [[unroll]] for (uint j = 0u; j < 2u; j++) {
        coopMatStore(acc[i][j], Cs, base, 16u, gl_CooperativeMatrixLayoutColumnMajor);
        subgroupBarrier();
        for (uint e = lane; e < 256u; e += 32u) {
            uint r = r0 + sr + i * 16u + (e & 15u);
            uint t = t0 + st + j * 16u + (e >> 4);
            if (r < p.rows && t < p.n_tokens) {
                uint yi = p.y_off + t * p.y_stride + r;
                float v = Cs[base + e] + (p.has_bias != 0u ? bias[r] : 0.0);
                y[yi] = p.mode == 1u ? y[yi] + v : v;
            }
        }
        subgroupBarrier();
    }
}
